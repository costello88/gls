# ── Supabase ──────────────────────────────────────────────────────────────
# Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...        # server-only, never exposed to the browser

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app   # no trailing slash; use http://localhost:3000 in dev

# ── Instagram (Meta app with "Instagram API with Instagram Login") ────────
# developers.facebook.com → your app → Instagram → API setup with Instagram login
META_APP_ID=1234567890
META_APP_SECRET=abc123...
# Optional: pin the Graph API version (default v25.0)
# META_GRAPH_VERSION=v25.0

# ── Security ──────────────────────────────────────────────────────────────
# openssl rand -hex 32  (exactly 64 hex chars — encrypts Instagram tokens at rest)
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 24  (protects /api/cron/dispatch; Vercel sends it automatically)
CRON_SECRET=

# ── AI providers (ALL OPTIONAL — the local template engine always works) ──
# Claude: captions, campaign plans, art direction
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI: image restyling variants (gpt-image-1 edits)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_QUALITY=medium

# Replicate: FLUX Kontext image restyling with native 4:5 / 9:16 output
REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-kontext-pro

# Higgsfield (Soul) — gated Cloud API; leave empty unless you have enterprise access
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HIGGSFIELD_API_BASE=https://platform.higgsfield.ai/v1
